<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/usersToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="Usuarios"
        app:titleTextColor="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="Cuentas que han iniciado sesión en la aplicación"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="Desactivar conserva el historial, pero bloquea nuevos inicios de sesión."
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/usersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="Todavía no hay usuarios registrados."
        android:textColor="@color/text_gray"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TableLayout
            android:id="@+id/usersTable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:stretchColumns="0,1,2,3,4,5">

            <TableRow
                android:id="@+id/usersHeader"
                android:background="@color/primary_blue">
                <TextView android:text="Nombre" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" />
                <TextView android:text="Correo" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" />
                <TextView android:text="Último acceso" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" />
                <TextView android:text="Accesos" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" />
                <TextView android:text="Estado" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" />
                <TextView android:text="Acción" android:textColor="@color/white" android:textStyle="bold" android:padding="12dp" />
            </TableRow>
        </TableLayout>
    </HorizontalScrollView>
</LinearLayout>
