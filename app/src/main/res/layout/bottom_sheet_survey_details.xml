<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/surveyDetailsSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_palette_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/surveyDetailsHandle"
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bottom_sheet_handle" />

    <TextView
        android:id="@+id/detailsSurveyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#0F1115"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailsSurveyInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#0F1115"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Código QR"
        android:textColor="#0F1115"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/detailsSurveyQr"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        android:contentDescription="Código QR de la encuesta"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/detailsSurveyUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#0F1115"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeSurveyDetails"
        style="@style/App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cerrar"
        android:textColor="#0F1115" />
</LinearLayout>
